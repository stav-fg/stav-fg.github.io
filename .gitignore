
.DS_Store
node_modules/


# Source material stays local and is never published: this repo is public.
source-material/


# Working notes and drafts live in private/ (below), not in the repo.
notes/
drafts/
HANDOFF.md

# Local Python environment for tools/figextract.py. Rebuilt by tools/setup.sh.
env/

# The list of strings that must never be committed. Local only, for obvious reasons.
.confidential-terms

# Archives of source material. A zip at the repo root is not covered by
# source-material/, so one `git add -A` would publish it. Never commit these.
*.zip

# Plaintext case studies and their images. The published work/*.html pages are built from these
# by tools/lock_cases.py and carry only ciphertext, because this repo is public. Never commit.
# The passwords live in private/passwords.json for the same reason.
private/
